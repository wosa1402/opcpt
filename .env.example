# 必填：VNC/noVNC 登录密码。传统 VNC 只使用前 8 个字符。
VNC_PASSWD=

# 必填：DeepSeek 官方兼容渠道。地址按你的中转站原样填写，不会自动追加 /v1。
DEEPSEEK_BASE_URL=
DEEPSEEK_API_KEY=

# 默认使用 DeepSeek Chat；需要时可改成 deepseek-reasoner。
DEEPSEEK_MODEL_ID=deepseek-chat
DEEPSEEK_MODEL_NAME=DeepSeek Chat
DEEPSEEK_API=openai-completions

# 留空时，每次容器启动都会生成新的本机 Gateway token。
OPENCLAW_GATEWAY_TOKEN=

# 2 核 / 16 GB 目标规格：给 KDE 救援桌面和用户程序留出余量。
OPENCLAW_NODE_HEAP_MB=2048
CHROME_RENDERER_LIMIT=3
# 仅作为连接前的初始尺寸；noVNC 连接后默认使用 Remote Resizing 跟随浏览器窗口。
VNC_GEOMETRY=1600x900
VNC_DEPTH=24

# 版本化备份：本地/HF Compose 会覆盖为 /data/openclaw-data；ModelScope 自动选 /mnt/workspace/openclaw-data。
OPENCLAW_PERSIST_DIR=
BACKUP_START_DELAY_SECONDS=60
BACKUP_MIN_INTERVAL_SECONDS=120
BACKUP_MAX_INTERVAL_SECONDS=900
BACKUP_KEEP=5
BACKUP_MAX_MIB=4096

# 内存守护：先停 Chrome，再停 OpenClaw，紧急时终止最大的非核心进程。
MEMORY_WARNING_PERCENT=80
MEMORY_CRITICAL_PERCENT=88
MEMORY_EMERGENCY_PERCENT=94
MEMORY_RECOVERY_PERCENT=72
MEMORY_GUARD_INTERVAL_SECONDS=2
MEMORY_KILL_MIN_RSS_MIB=256

# 仅首次从旧版镜像迁移时设为 1；成功生成新快照后立即改回 0。
IMPORT_LEGACY_BACKUP=0

# 故障恢复：只在需要重建默认 OpenClaw 配置的那次启动设为 1。
RESET_OPENCLAW_CONFIG=0
