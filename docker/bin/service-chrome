#!/usr/bin/env bash
set -Eeuo pipefail

for _ in $(seq 1 600); do
    if [[ -S /tmp/.X11-unix/X1 \
        && -S /run/user/0/bus \
        && -e /run/openclaw/bootstrap.ready ]]; then
        break
    fi
    sleep 1
done

[[ -S /tmp/.X11-unix/X1 \
    && -S /run/user/0/bus \
    && -e /run/openclaw/bootstrap.ready ]] \
    || { echo '[chrome] X server, session bus, or bootstrap did not become ready.' >&2; exit 1; }

exec /usr/local/bin/start-chrome-session
