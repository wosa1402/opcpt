#!/usr/bin/env bash
set -Eeuo pipefail

/usr/local/bin/set-oom-score -1000 novnc || true

for _ in $(seq 1 120); do
    if nc -z 127.0.0.1 "${VNC_PORT:-5901}"; then
        exec /usr/bin/websockify \
            --web /usr/share/novnc \
            --heartbeat 30 \
            "0.0.0.0:${NOVNC_PORT:-7860}" \
            "127.0.0.1:${VNC_PORT:-5901}"
    fi
    sleep 1
done

echo '[novnc] VNC server did not become ready.' >&2
exit 1
