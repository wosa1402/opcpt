#!/usr/bin/env bash
set -Eeuo pipefail

/usr/local/bin/set-oom-score 200 bootstrap || true

ready_file=/run/openclaw/bootstrap.ready
status_file=/run/openclaw/bootstrap.status

finish() {
    local exit_code=$?
    if (( exit_code == 0 )); then
        printf 'ready\n' > "${status_file}"
    else
        printf 'degraded exit=%s\n' "${exit_code}" > "${status_file}"
    fi
    touch "${ready_file}"
}
trap finish EXIT

echo '[bootstrap] 正在从最近一份有效快照恢复数据。'
if ! /usr/local/bin/openclaw-restore-latest; then
    echo '[bootstrap] 恢复失败；保留救援桌面并以空白运行目录继续启动。' >&2
fi

install -d -m 0700 /root/.config
if [[ ! -e /root/.config/openclaw-chrome && -d /root/.config/google-chrome ]]; then
    mv -- /root/.config/google-chrome /root/.config/openclaw-chrome
    echo '[bootstrap] 已把旧版 Chrome 用户资料迁移到受管专用目录。'
fi

install -d -m 0700 \
    /root/.config/openclaw-chrome \
    /root/.openclaw \
    /root/.openclaw/workspace \
    /root/.local/share \
    /root/Desktop \
    /root/Documents \
    /root/Downloads \
    /root/Projects \
    /root/Services \
    /root/Startup

cp -an /usr/local/share/openclaw/plasma-default/. /root/.config/
install -d -m 0700 /root/.config/fcitx5
cp -an /usr/local/share/openclaw/fcitx5-default/. /root/.config/fcitx5/

# Plasma 6 defaults to an adaptive floating panel. Keep the Windows-like
# attached taskbar unless the user has explicitly chosen another value.
kreadconfig_bin="$(command -v kreadconfig6 || command -v kreadconfig5 || true)"
kwriteconfig_bin="$(command -v kwriteconfig6 || command -v kwriteconfig5 || true)"
if [[ -n "${kreadconfig_bin}" && -n "${kwriteconfig_bin}" ]]; then
    panel_ids=(2)
    plasma_layout=/root/.config/plasma-org.kde.plasma.desktop-appletsrc
    if [[ -f "${plasma_layout}" ]]; then
        while IFS= read -r panel_id; do
            [[ -n "${panel_id}" ]] && panel_ids+=("${panel_id}")
        done < <(
            awk '
                /^\[Containments\]\[[0-9]+\]$/ {
                    panel_id=$0
                    sub(/^\[Containments\]\[/, "", panel_id)
                    sub(/\]$/, "", panel_id)
                    next
                }
                panel_id != "" && $0 == "plugin=org.kde.panel" {
                    print panel_id
                    panel_id=""
                }
            ' "${plasma_layout}"
        )
    fi

    while IFS= read -r panel_id; do
        [[ -n "${panel_id}" ]] || continue
        floating="$(${kreadconfig_bin} \
            --file plasmashellrc \
            --group PlasmaViews \
            --group "Panel ${panel_id}" \
            --key floating \
            --default __unset__)"
        if [[ "${floating}" == __unset__ ]]; then
            "${kwriteconfig_bin}" \
                --file plasmashellrc \
                --group PlasmaViews \
                --group "Panel ${panel_id}" \
                --key floating 0
        fi
    done < <(printf '%s\n' "${panel_ids[@]}" | sort -u)
fi

# These shortcuts are image-managed. Overwrite only the known names so an
# upgrade from the former XFCE image cannot leave launchers pointing at
# removed XFCE applications; unrelated user files remain untouched.
cp -a /usr/local/share/openclaw/desktop-default/. /root/Desktop/
find /root/Desktop -maxdepth 1 -type f -name '*.desktop' -exec chmod 0755 {} +

config_path=/root/.openclaw/openclaw.json
if [[ "${RESET_OPENCLAW_CONFIG:-0}" == 1 && -f "${config_path}" ]]; then
    config_backup="${config_path}.backup.$(date -u +%Y%m%dT%H%M%SZ)"
    cp -p -- "${config_path}" "${config_backup}"
    install -m 0600 /usr/local/share/openclaw/openclaw-template.json "${config_path}"
    echo "[bootstrap] 已重置 OpenClaw 配置；旧文件保存在 ${config_backup}。"
elif [[ ! -f "${config_path}" ]]; then
    if [[ -n "${OPENCLAW_CONFIG_SOURCE:-}" && -f "${OPENCLAW_CONFIG_SOURCE}" ]]; then
        install -m 0600 "${OPENCLAW_CONFIG_SOURCE}" "${config_path}"
        echo '[bootstrap] 已安装用户提供的 OpenClaw 配置。'
    else
        install -m 0600 /usr/local/share/openclaw/openclaw-template.json "${config_path}"
        echo '[bootstrap] 已初始化 DeepSeek 兼容配置（不含密钥）。'
    fi
fi

rm -f -- /root/.config/openclaw-chrome/SingletonCookie \
    /root/.config/openclaw-chrome/SingletonLock \
    /root/.config/openclaw-chrome/SingletonSocket

touch /run/openclaw/backup.dirty
echo '[bootstrap] 运行目录已经准备完成。'
